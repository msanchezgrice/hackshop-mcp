# Required for the live demo on the homepage. Set this in Vercel project env.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5-20251001 to keep demo costs low.
# Override with claude-sonnet-4-6 for higher quality at ~10x cost.
HACKSHOP_MODEL=claude-haiku-4-5-20251001

# Optional. When BOTH are set, the /api/propose route fetches live eBay
# listings (count + cheapest item) for each proposed device and hides
# devices with zero listings. Without these vars, eBay links fall back
# to plain search URLs (some may return empty results).
#
# Provisioning: developer.ebay.com -> create app -> Production keyset.
# 1-2 days for sandbox->production migration.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Per-IP rate limit on /api/propose. Default 200/hour (generous
# enough for active dogfooding, bounded enough to cap Anthropic cost from
# scrapers). Set SKIP_RATE_LIMIT=true to disable entirely.
RATE_LIMIT_PER_HOUR=200
# SKIP_RATE_LIMIT=true

# Optional. Required only to enable /api/diagram (architecture-sketch
# generation via OpenAI gpt-image-1). Without it the Generate-diagram
# button surfaces a clear "not enabled" message instead of erroring.
# Generation cost: ~$0.04 per image at default settings; cached per
# (idea, device_set) for 24h. Get a key at platform.openai.com/api-keys.
OPENAI_API_KEY=
# Override the model id if needed (default: gpt-image-1)
HACKSHOP_IMAGE_MODEL=gpt-image-1

# Optional. Base URL of the Python sim-worker (MuJoCo physics + render). The
# /api/simulate routes proxy to it (POST kicks a job, GET polls). Physics
# simulation is ONLY enabled when this is set: the routes report
# configured:false and return an honest 503 otherwise. For local dev, run the
# sim-worker and point this at it (e.g. http://127.0.0.1:8000). The worker URL
# is server-only and is never exposed to the browser.
SIM_WORKER_URL=
# Optional. Per-IP rate limit on /api/simulate. Default 60/hour.
SIM_RATE_LIMIT_PER_HOUR=60
