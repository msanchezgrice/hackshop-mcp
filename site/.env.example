# Required for the live demo on the homepage. Set this in Vercel project env.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-haiku-4-5-20251001 to keep demo costs low.
# Override with claude-sonnet-4-6 for higher quality at ~10x cost.
HACKSHOP_MODEL=claude-haiku-4-5-20251001

# Optional. When BOTH are set, the /api/propose route fetches live eBay
# listings (count + cheapest item) for each proposed device and hides
# devices with zero listings. Without these vars, eBay links fall back
# to plain search URLs (some may return empty results).
#
# Provisioning: developer.ebay.com -> create app -> Production keyset.
# 1-2 days for sandbox->production migration.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
